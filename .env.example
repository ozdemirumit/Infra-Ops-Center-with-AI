# === Infra Ops Center with AI — Configuration ===
# Run 'python setup_env.py' to generate this file automatically.

# --- AI Provider ---
DEFAULT_PROVIDER=anthropic
DEFAULT_MODEL=claude-sonnet-4-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Ollama (local model server) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- AI Proxy (onPrem LLM Sentinel — optional) ---
PROXY_ENABLED=false
PROXY_HOST=localhost
PROXY_PORT=8765
PROXY_API_KEY=
# Admin token (optional) — needed to see custom proxy providers
# Without it, /v1/providers returns 403 and Heimdal/etc are hidden
PROXY_ADMIN_KEY=

# --- Authentication (generated by setup_env.py) ---
APP_USERNAME=admin
APP_PASSWORD_HASH=
ADMIN_USERS=admin

# --- Device Encryption (generated by setup_env.py) ---
DEVICE_ENCRYPTION_KEY=

# --- SSH ---
SSH_TIMEOUT=20
SSH_EXEC_TIMEOUT=1800
SSH_OUTPUT_LIMIT=5000

# --- Agent ---
MAX_AGENT_STEPS=25

# --- RAG ---
RAG_ENABLED=true
RAG_CHUNK_SIZE=1000
RAG_TOP_K=5
